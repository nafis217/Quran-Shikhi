QF_AUTH_BASE=                  # e.g. https://<auth-host>  (confirm from QF docs)
QF_API_BASE=
QF_CLIENT_ID=
QF_CLIENT_SECRET=
ConnectionStrings__Default=Server=localhost,1433;Database=QuranShikkha;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
