{
  "name": "@quran-shikkha/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "fetch-spec": "curl -s ${API_URL:-http://localhost:5038}/openapi/v1.json -o openapi.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "openapi-fetch": "^0.13.0" },
  "devDependencies": { "openapi-typescript": "^7.4.0", "typescript": "^5.6.0" }
}
