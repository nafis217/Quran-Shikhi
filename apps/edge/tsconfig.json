{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"], "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "scripts", "tests", "../../functions"]
}
